# Copy to .env.local and fill in. Never commit .env.local.

# Public website configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_LEGAL_TEXT=

# Server-only contact form configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Private inbox where enquiries are delivered
CONTACT_TO_EMAIL=
# Sender. Use onboarding@resend.dev while testing, then your verified domain.
CONTACT_FROM_EMAIL="Manic Accounting <onboarding@resend.dev>"
