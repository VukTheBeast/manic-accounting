# Copy to .env.local and fill in. Never commit .env.local.

# Public: shown on the website and used for the mailto fallback
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Contact form (Resend, https://resend.com). Free tier is enough to start.
RESEND_API_KEY=
# Where enquiries are delivered
CONTACT_TO_EMAIL=
# Sender. Use onboarding@resend.dev while testing, then your verified domain.
CONTACT_FROM_EMAIL="Manić Accounting <onboarding@resend.dev>"
