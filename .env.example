# Copy to .env.local and fill in. Never commit .env.local.

# Public website configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_LEGAL_TEXT=

# Server-only email configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Resend webhook signing secret for /api/resend/inbound
RESEND_WEBHOOK_SECRET=
# Private inbox where form submissions and inbound domain mail are forwarded
CONTACT_FORWARD_TO_EMAIL=vukman.manic90@gmail.com
# Verified sender used for website notifications and forwarding
CONTACT_FROM_EMAIL="Manic Accounting <contact@manic-accounting.com>"
